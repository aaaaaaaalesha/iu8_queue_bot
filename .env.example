# Telegram Bot API token from @BotFather (required).
TELE_API_TOKEN=
# Path to the SQLite database file.
DATABASE_PATH=queue_bot.db
# Time zone used for planning queues.
TIMEZONE=Europe/Moscow
# Minimal pause (seconds) between two edits of one queue message; presses made
# during the pause are merged into a single edit.
QUEUE_EDIT_INTERVAL=1.0
LOG_LEVEL=INFO
